# ==============================================================================
# NUTRITRACK ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase PostgreSQL & Authentication Configuration
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Optional: for server-side elevated admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini Vision API Key (For AI Meal Image Analysis)
# Get a key at: https://aistudio.google.com/
# When not set, NutriTrack runs in calibrated simulation mode with verified Indian & global food datasets.
GEMINI_API_KEY=your_gemini_api_key_here

# App Base URL (Optional, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
